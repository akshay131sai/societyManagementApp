# Frontend environment — apps/web
#
# EVERYTHING HERE IS PUBLIC. Vite inlines VITE_* variables into the browser
# bundle. Never put the Firebase service account, database credentials or
# payment secrets in this file; those belong in the backend .env only.

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AUTH_PROVIDER=password

# Firebase web config. Designed to be public — it is not a secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
