# =============================================================================
# NestFlow — environment template
#
# Copy to .env and fill in. NEVER commit .env.
# Server-side secrets (Firebase service account, database passwords, payment
# credentials) must never appear in any VITE_* variable — those are compiled
# into the browser bundle and are public.
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND — apps/api
# -----------------------------------------------------------------------------

ENVIRONMENT=development           # development | staging | production
DEBUG=true
HOST=127.0.0.1
PORT=8000

# --- Central database --------------------------------------------------------
CENTRAL_DATABASE_URL=postgresql+psycopg://nestflow:nestflow_dev_pw@localhost:5433/nestflow_platform

# --- Tenant databases --------------------------------------------------------
# Tenant DSNs are BUILT from these parts plus the generated database name, so a
# dump of the central database carries no usable tenant credentials.
# TENANT_DB_USER needs CREATEDB (provisioning issues CREATE DATABASE).
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5433
TENANT_DB_USER=nestflow
TENANT_DB_PASSWORD=nestflow_dev_pw
TENANT_DB_MAINTENANCE_DB=postgres

# --- Pooling -----------------------------------------------------------------
# Worst-case connections per worker:
#   TENANT_ENGINE_CACHE_SIZE * (TENANT_POOL_SIZE + TENANT_POOL_MAX_OVERFLOW)
#   + CENTRAL_POOL_SIZE + CENTRAL_POOL_MAX_OVERFLOW
# Keep this comfortably under the server's max_connections.
CENTRAL_POOL_SIZE=10
CENTRAL_POOL_MAX_OVERFLOW=5
TENANT_ENGINE_CACHE_SIZE=15
TENANT_POOL_SIZE=2
TENANT_POOL_MAX_OVERFLOW=3
POOL_RECYCLE_SECONDS=1800
POOL_TIMEOUT_SECONDS=30

# --- Authentication ----------------------------------------------------------
# firebase = real Firebase ID token verification (required in production)
# dev      = accepts "dev:<email>" with NO credential check. Local only.
#            The process REFUSES TO START with dev + ENVIRONMENT=production.
AUTH_PROVIDER=dev

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the PEM with literal \n escapes, wrapped in double quotes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
FIREBASE_CHECK_REVOKED=true

# --- CORS --------------------------------------------------------------------
# Explicit list. A wildcard is refused in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANON_PER_MIN=20
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_WRITE_PER_MIN=60

# --- Storage -----------------------------------------------------------------
STORAGE_PROVIDER=local            # local | s3
STORAGE_LOCAL_PATH=./var/uploads
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE_URL=/static/uploads

# --- Payments (Phase 4) ------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# --- Scheduling (Phase 6) ----------------------------------------------------
# APScheduler runs inside the API process: nightly task generation, notice
# publication, visitor-pass expiry, booking reminders, subscription expiry.
# Switch it OFF on every web worker but one — two processes running the same
# sweep send every notification twice.
SCHEDULER_ENABLED=true

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false                    # true in staging/production

# --- Locale ------------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LOCALE=en-IN
DEFAULT_CURRENCY=INR


# -----------------------------------------------------------------------------
# FRONTEND — apps/web
#
# Everything below is PUBLIC: Vite inlines VITE_* into the browser bundle.
# The Firebase web config is designed to be public; it is not a secret.
# The service account above is a secret and must never appear here.
# -----------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_API_BASE_URL=http://localhost:8000/api/v1

# Mirrors the backend AUTH_PROVIDER. When "dev", the login screen signs in with
# a dev token instead of the Firebase SDK and shows a development badge.
VITE_AUTH_PROVIDER=dev
